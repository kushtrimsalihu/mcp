{
    "name": "mcp-ai/laravel-dev-productivity",
    "description": "Proof-of-concept MCP server exposing Laravel code-review tools (search, git diff, route inspection) to AI clients.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "php-mcp/server": "^3.3",
        "symfony/process": "^7.0",
        "symfony/finder": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "McpAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "McpAi\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/mcp-server"
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
